# GitHub Actions uses repository Secrets and Variables for unattended runs.
# Optional public-source enhancers
YOUTUBE_API_KEY=
X_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# DashScope content generation
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen3.6-flash-2026-04-16
DASHSCOPE_MODEL_FALLBACKS=qwen3.6-flash-2026-04-16,qwen3.5-flash,qwen3.5-35b-a3b,qwen3.5-27b,qwen3.5-122b-a10b
DASHSCOPE_REVIEW_MODEL=qwen3.5-flash
DASHSCOPE_REVIEW_MODEL_FALLBACKS=qwen3.5-flash,qwen3.6-flash-2026-04-16,qwen3.5-27b
DASHSCOPE_TIMEOUT_SECONDS=180
PIPELINE_FORCE_REFRESH=0

# Optional IndexNow submission
INDEXNOW_KEY=
INDEXNOW_HOST=wenxingai.top
INDEXNOW_KEY_LOCATION=https://wenxingai.top/indexnow-key.txt

# Optional multi-platform distribution via Buffer
BUFFER_API_KEY=
BUFFER_THREADS_PROFILE_ID=
BUFFER_X_PROFILE_ID=
BUFFER_FACEBOOK_PROFILE_ID=
BUFFER_INSTAGRAM_PROFILE_ID=
