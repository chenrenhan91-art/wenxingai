# GitHub Actions uses repository Secrets and Variables for unattended runs.
# Optional public-source enhancers
YOUTUBE_API_KEY=
X_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# Gemini content generation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
GEMINI_REVIEW_MODEL=gemini-2.5-pro
GEMINI_TIMEOUT_SECONDS=180
PIPELINE_FORCE_REFRESH=0

# Optional multi-platform distribution via Buffer
BUFFER_API_KEY=
BUFFER_THREADS_PROFILE_ID=
BUFFER_X_PROFILE_ID=
BUFFER_FACEBOOK_PROFILE_ID=
BUFFER_INSTAGRAM_PROFILE_ID=
BUFFER_DRY_RUN=1
SOCIAL_ENABLED_PLATFORMS=threads,x,instagram
SOCIAL_DEFAULT_LOCALE=zh_hant
SOCIAL_THREADS_LOCALE=zh_hant
SOCIAL_X_LOCALE=zh_cn
SOCIAL_INSTAGRAM_LOCALE=zh_hant
SOCIAL_LANDING_URL=https://wenxingai.top/
SOCIAL_THREADS_LANDING_URL=
SOCIAL_X_LANDING_URL=
SOCIAL_INSTAGRAM_LANDING_URL=
