DISTRIBUTION_STATE_RETENTION_DAYS=60
SOCIAL_ENABLED_PLATFORMS=threads,x,instagram
SOCIAL_DEFAULT_LOCALE=zh_hant
SOCIAL_THREADS_LOCALE=zh_hant
SOCIAL_X_LOCALE=zh_cn
SOCIAL_INSTAGRAM_LOCALE=zh_hant
